{
    "name": "matthijs-neijenhuijs/klaviyo-for-laravel",
    "description": "Interact with the Klaviyo API from your Laravel app",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthijs Neijenhuijs",
            "email": "matthijs@dutchbridge.nl"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/bus": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.3|^10.0|^11.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "DutchBridge\\KlaviyoForLaravel\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DutchBridge\\KlaviyoForLaravel\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "DutchBridge\\KlaviyoForLaravel\\KlaviyoForLaravelServiceProvider"
            ],
            "aliases": {
                "Klaviyo": "DutchBridge\\KlaviyoForLaravel\\Klaviyo"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
